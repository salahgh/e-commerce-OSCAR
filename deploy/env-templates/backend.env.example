# ────────────────────────────────────────────────────────────────
# Vendure backend (apps/backend) — production env
# Generated by deploy/scripts/04-write-env.sh. Hand-edit anything
# you want different, then `pm2 reload oscar-backend --update-env`.
# ────────────────────────────────────────────────────────────────

NODE_ENV=production

# Server
PORT=8085
# Comma-separated. Must match the public origins you serve from Caddy.
CORS_ORIGINS=https://oscarfashion.dz,https://www.oscarfashion.dz,https://admin.oscarfashion.dz

# Database — local Postgres on the same VPS (created by 02-setup-postgres.sh)
DATABASE_URL=postgres://oscar:REPLACE_ME@127.0.0.1:5432/oscar_fashion?schema=public

# Superadmin (used by `populate` and by the built-in admin UI)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=CHANGE_ME

# Session cookie signing key — 32+ random bytes (openssl rand -hex 32)
COOKIE_SECRET=REPLACE_ME

# ── SMTP (optional — leave blank to disable transactional email) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── CIB payment gateway (optional) ──
# CIB_MERCHANT_ID=
# CIB_TERMINAL_ID=
# CIB_SECRET_KEY=
# CIB_API_URL=
# CIB_TEST_MODE=false

# ── Baridimob payment gateway (optional) ──
# BARIDIMOB_MERCHANT_ACCOUNT=
# BARIDIMOB_API_KEY=
# BARIDIMOB_SECRET_KEY=
# BARIDIMOB_API_URL=
# BARIDIMOB_TEST_MODE=false
