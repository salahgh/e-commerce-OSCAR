# ────────────────────────────────────────────────────────────────
# Next.js storefront (apps/frontend) — production env
# Values are baked into the client bundle at build time.
# After changing any NEXT_PUBLIC_* var you MUST rebuild the frontend.
# ────────────────────────────────────────────────────────────────

# Vendure Shop API (HTTPS via Caddy)
NEXT_PUBLIC_GRAPHQL_URL=https://api.oscarfashion.dz/shop-api
NEXT_PUBLIC_GRAPHQL_WS_URL=wss://api.oscarfashion.dz/shop-api

# Storefront canonical URL
NEXT_PUBLIC_SITE_URL=https://oscarfashion.dz

# Where Vendure serves product images (same backend, /assets path)
NEXT_PUBLIC_CDN_URL=https://api.oscarfashion.dz/assets

# Feature flags
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_COMPARE=false

# Ad pixels (oscarfashion.dz storefront — NOT the Spin & Win promo store IDs).
# Leave empty to disable tracking.
NEXT_PUBLIC_META_PIXEL_ID=1795558734909993
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DAA2TURC77UBPDTVK0FG
