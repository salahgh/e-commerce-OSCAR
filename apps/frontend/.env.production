NEXT_PUBLIC_TIKTOK_PIXEL_ID=DAA2TURC77UBPDTVK0FG

# Analytics — same sheet. Contentsquare ID is the file name in the snippet's
# https://t.contentsquare.net/uxa/<id>.js URL.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-4Z9NMNQCQ4
NEXT_PUBLIC_CONTENTSQUARE_ID=a6b366dbf9c99
