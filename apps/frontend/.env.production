# API Configuration - Vendure Shop API
NEXT_PUBLIC_GRAPHQL_URL=https://api.oscarfashion.dz/shop-api
NEXT_PUBLIC_SITE_URL=https://oscarfashion.dz

# Ad pixels — tracking disabled anywhere these are unset.
# IDs come from the client's "Platforms Code" sheet for the storefront
# (the Spin & Win promo store has its own, different pixels).
