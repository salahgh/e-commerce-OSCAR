{
  "name": "@oscar/backend",
  "version": "1.0.0",
  "description": "OSCAR Fashion E-Commerce - Vendure Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node ./src/index.ts",
    "build": "tsc",
    "start": "node ./dist/index.js",
    "seed-initial": "ts-node ./src/seed-initial.ts",
    "populate": "ts-node ./src/populate.ts",
    "seed": "cross-env SEED_CONFIRM=yes ts-node ./src/seed-initial.ts && cross-env SEED_CONFIRM=yes ts-node ./src/populate.ts && cross-env SEED_CONFIRM=yes ts-node ./src/link-products-to-collections.ts",
    "seed-orders": "ts-node ./src/seed-orders.ts",
    "link-products": "ts-node ./src/link-products-to-collections.ts",
    "reindex": "ts-node ./src/reindex.ts",
    "fix-jobs": "ts-node ./src/fix-jobs.ts",
    "cleanup-jobs": "ts-node ./src/cleanup-jobs.ts",
    "cleanup-db": "ts-node ./src/cleanup-jobs-db.ts",
    "migration:generate": "ts-node ./node_modules/.bin/typeorm migration:generate -d ./src/vendure-config.ts",
    "migration:run": "ts-node ./node_modules/.bin/typeorm migration:run -d ./src/vendure-config.ts",
    "migration:revert": "ts-node ./node_modules/.bin/typeorm migration:revert -d ./src/vendure-config.ts",
    "migration:gen": "ts-node ./src/generate-migration.ts",
    "seed:site-content": "ts-node ./src/seed-site-content.ts"
  },
  "keywords": [
    "e-commerce",
    "vendure",
    "oscar",
    "fashion",
    "algeria"
  ],
  "author": "OSCAR Fashion",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vendure/admin-ui": "^3.5.1",
    "@vendure/admin-ui-plugin": "^3.5.1",
    "@vendure/asset-server-plugin": "^3.5.1",
    "@vendure/core": "^3.5.1",
    "@vendure/email-plugin": "^3.5.1",
    "@vendure/ui-devkit": "^3.5.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cross-env": "^7.0.3"
  }
}
