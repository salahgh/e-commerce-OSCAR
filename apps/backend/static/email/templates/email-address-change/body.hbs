<mjml>
  <mj-body>
    {{> header}}

    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text font-size="20px" color="#1a1a2e" font-weight="bold">
          Confirmez votre nouvelle adresse email
        </mj-text>
        <mj-text color="#333333">
          Bonjour {{customer.firstName}},
        </mj-text>
        <mj-text color="#333333">
          Vous avez demandé à changer votre adresse email. Cliquez sur le bouton ci-dessous pour confirmer.
        </mj-text>
        <mj-button background-color="#1a1a2e" color="#ffffff" href="{{changeEmailAddressUrl}}">
          Confirmer le changement
        </mj-button>
      </mj-column>
    </mj-section>

    {{> footer}}
  </mj-body>
</mjml>
