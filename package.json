{
  "name": "oscar-fashion",
  "private": true,
  "description": "OSCAR Fashion E-Commerce Platform",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@oscar/backend",
    "dev:frontend": "turbo run dev --filter=@oscar/frontend",
    "dev:backoffice": "turbo run dev --filter=@oscar/backoffice",
    "dev:mobile": "turbo run dev --filter=@oscar/mobile",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "format": "turbo run format"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "turbo": "^2.8.20"
  }
}
