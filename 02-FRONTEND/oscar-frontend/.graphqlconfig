{
  "name": "OSCAR Fashion GraphQL Schema",
  "schemaPath": "schema.graphql",
  "extensions": {
    "endpoints": {
      "default": {
        "url": "http://localhost:8085/graphql",
        "headers": {
          "Content-Type": "application/json"
        },
        "introspect": true
      },
      "production": {
        "url": "${NEXT_PUBLIC_GRAPHQL_URL}",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    }
  }
}
