# API Configuration
NEXT_PUBLIC_GRAPHQL_URL=https://api.oscarfashion.dz/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=wss://api.oscarfashion.dz/graphql
NEXT_PUBLIC_SITE_URL=https://oscarfashion.dz

# Authentication
NEXT_PUBLIC_JWT_SECRET=your-production-jwt-secret-key
JWT_EXPIRATION=7d

# CDN Configuration
NEXT_PUBLIC_CDN_URL=https://cdn.oscarfashion.dz
NEXT_PUBLIC_IMAGE_OPTIMIZATION_URL=https://oscarfashion.dz/_next/image

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_COMPARE=false
